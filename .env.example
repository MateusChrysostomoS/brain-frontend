# PreCheck API base URL. Empty = same-origin/relative.
# Used by lib/api.ts for the existing PreCheck dashboard calls.
NEXT_PUBLIC_API_URL=

# brain-api base (login + /auth/me + entitlements + demo-requests).
# Used by lib/manage-api.ts.
#
# In PRODUCTION this is a same-origin PATH, not an origin: nginx.conf proxies
# `location /api/` to the real brain-api, so the browser only ever talks to one
# origin and the session's refresh token can be a first-party HttpOnly cookie
# (`__Host-refresh_token`). Point it back at the brain-api origin and that cookie
# becomes third-party again — Safari's ITP and Firefox's ETP are then free to drop
# it, and the silent refresh fails for a slice of real users with nothing failing
# loudly. The production value lives in the Dockerfile ARG, as always.
#
# For LOCAL development against a brain-api on another port, put the full origin
# here (scheme + host, no trailing slash). localhost counts as the same SITE
# across ports, so the cookie still works — and brain-api must list this app's
# origin in CORS_ALLOW_ORIGINS.
NEXT_PUBLIC_MANAGE_API_BASE_URL=/api

# secretarIA hub API base URL (doctor-hub config + calendar, via a short-lived
# hub token minted by brain-api). Used by lib/secretaria-hub.ts. Empty keeps
# the /secretaria/agenda and /secretaria/configuracao routes in demo mode.
NEXT_PUBLIC_SECRETARIA_HUB_BASE_URL=

# The secretarIA FRONTEND's public origin (the separate secretarIA-frontend app).
# Every link that used to open /secretaria/agenda or /secretaria/configuracao in
# THIS app now points here. Leave empty and those affordances say the secretarIA
# app is not configured, instead of linking to a route that no longer exists.
NEXT_PUBLIC_SECRETARIA_APP_BASE_URL=
